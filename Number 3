USD_TO_RUB = 95.50

def convert_usd_to_rub(usd_input):
    """
    Конвертирует сумму из долларов США в российские рубли.

    Args:
        usd_input (float): Сумма в долларах.

    Returns:
            float: Рассчитанная сумма в рублях по установленному курсу.
    """
    result_rub = usd_input * USD_TO_RUB
    return result_rub

usd_input = float(input("Введите сумму в долларах: "))

rub_output = convert_usd_to_rub(usd_input)

print(f"Результат конвертации: {usd_input:.2f} $ = {rub_output:.2f} руб.")
