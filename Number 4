import math

def calculate_rectangle_area (rectangle_width, rectangle_height):
    """
    Вычисляет площадь прямоугольника по его ширине и высоте.

    Args:
        rectangle_width (float): Ширина прямоугольника.
        rectangle_height (float): Высота прямоугольника.

    Returns:
        float: Площадь прямоугольника.
    """
    area = rectangle_width * rectangle_height
    return area

def calculate_circle_area(circle_radius):
    """
    Вычисляет площадь круга по его радиусу.

    Args:
        circle_radius (float): Радиус круга.

    Returns:
        float: Площадь круга.
    """
    area = math.pi * (circle_radius ** 2)
    return area

rectangle_width, rectangle_height = map(float, input("Введите ширину (см) и высоту (см) прямоугольника: ").split())

rectangle_area = calculate_rectangle_area(rectangle_width, rectangle_height)

print(f"Площадь прямоугольника равна: {rectangle_area:.2f}")

circle_radius = float(input("Введите радиус круга: "))

circle_area = calculate_circle_area(circle_radius)

print(f"Радиус круга равна: {circle_area:.2f}")
